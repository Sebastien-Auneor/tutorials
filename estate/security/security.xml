<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="estate_group_user" model="res.groups">
        <field name="name">Agent</field>
        <field name="category_id" ref="base.module_category_tutorials_estate" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="estate_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="base.module_category_tutorials_estate" />
        <field name="implied_ids"
            eval="[(4, ref('estate.estate_group_user'))]" />
    </record>

    <!-- Règle pour la LECTURE : voir toutes les propriétés de l'entreprise -->
    <record id="estate_property_user_read_rule" model="ir.rule">
        <field name="name">Estate: users can read all company properties</field>
        <field name="model_id" ref="model_estate_property" />
        <field name="domain_force">[
            '|', ('company_id', '=', False),
                 ('company_id', 'in', company_ids)
        ]</field>
        <field name="groups" eval="[(4, ref('estate.estate_group_user'))]" />
        <field name="perm_read" eval="True"/>
    </record>

    <!-- Règle pour l'ÉCRITURE : modifier seulement ses propres propriétés -->
    <record id="estate_property_user_write_rule" model="ir.rule">
        <field name="name">Estate: users can edit only their own properties</field>
        <field name="model_id" ref="model_estate_property" />
        <field name="domain_force">[
            '|', ('salesperson_id', '=', user.id),
                 ('salesperson_id', '=', False)
        ]</field>
        <field name="groups" eval="[(4, ref('estate.estate_group_user'))]" />
        <field name="perm_write" eval="True"/>
    </record>
</odoo>