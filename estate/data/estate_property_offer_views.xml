<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="estate_offer_model_action" model="ir.actions.act_window">
        <field name="name">Estate property offer</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form,kanban</field>
    </record>

    <record id="estate_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Estate Property Offer">
                <sheet>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="validity"/>
                            <field name="date_deadline"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Liste des offres">
                <field name="property_id"/>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept" string="Accept" type="object" icon="fa-check" invisible="status!='pending'" />
                <button name="action_refuse" string="Refuse" type="object" icon="fa-times" invisible="status!='pending'" />
                <field name="status"/>
            </list>
        </field>
    </record>
</odoo>